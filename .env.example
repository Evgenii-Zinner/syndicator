# Syndicator Worker - Local Development Variables (.dev.vars)

# Public Variables (configured in Cloudflare Dashboard Variables or .dev.vars)
ENVIRONMENT=development
RSS_FEED_URL=https://example.com/rss.xml
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_SERVICE=https://bsky.social
MASTODON_INSTANCE_URL=https://mastodon.social
SHORT_DOMAIN=s.example.com
THREADS_USER_ID=your_optional_threads_user_id
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Secrets (put via `wrangler secret put <KEY>` or Cloudflare Dashboard Secrets)
BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
X_ACCESS_TOKEN=your_x_access_token
THREADS_ACCESS_TOKEN=your_threads_access_token
NOSTR_PRIVATE_KEY=nsec1..._or_64_char_hex_private_key
API_SECRET=your_optional_manual_trigger_bearer_token
