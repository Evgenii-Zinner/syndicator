{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syndicator",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ]
}
